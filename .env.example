# Copy this file to .env and configure your LLM provider.

# Which LLM to use: "groq" (hosted, free tier, rate-limited) or "ollama" (local, no cap).
LLM_PROVIDER=groq

# --- Groq (LLM_PROVIDER=groq) ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# --- Ollama (LLM_PROVIDER=ollama) ---
# Install from https://ollama.com, then: ollama pull llama3.1:8b
# No key needed. Override the model here if you pulled a different one.
# OLLAMA_MODEL=llama3.1:8b
